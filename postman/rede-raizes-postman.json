      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/unidades",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Centro\",\n  \"endereco\": \"Rua A, 10\",\n  \"telefone\": \"41999999999\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
